# ====================================
# SOAR SIEM Environment Configuration
# ====================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ====================================
# BACKEND SECURITY SETTINGS
# ====================================
# REQUIRED: Generate strong secrets for production! Do NOT use defaults.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_JWT_SECRET_KEY

# ====================================
# DEFAULT ADMIN CREDENTIALS
# ====================================
# REQUIRED: Set a strong password before running the app for the first time
# Do NOT commit your actual password to git — use a secrets manager
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ====================================
# DATABASE (PostgreSQL for production)
# ====================================
# Local dev: leave empty (uses SQLite automatically)
# Production: set this to your PostgreSQL URL
# DATABASE_URL=postgresql://user:password@host:5432/soar_siem
DATABASE_URL=
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_POSTGRES_PASSWORD

# ====================================
# KAFKA CONFIGURATION
# ====================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LOGS=soc-logs

# ====================================
# ELASTICSEARCH CONFIGURATION
# ====================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ====================================
# REDIS CONFIGURATION (for Celery)
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================================
# CELERY CONFIGURATION
# ====================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ====================================
# THREAT INTELLIGENCE APIs
# ====================================
# Get your API keys from:
# - AbuseIPDB: https://www.abuseipdb.com/api
# - VirusTotal: https://developers.virustotal.com/
THREAT_INTELLIGENCE_API_KEY=your-alienvault-api-key-here
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# ====================================
# FRONTEND CONFIGURATION
# ====================================
# For local dev: http://localhost:5000
# For production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# ====================================
# LOGGING CONFIGURATION
# ====================================
LOG_LEVEL=INFO

# ====================================
# DEPLOYMENT ENVIRONMENT
# ====================================
# Options: development, staging, production
ENVIRONMENT=development

# ====================================
# WORKER CONFIGURATION
# ====================================
# URL for log consumer worker to send logs to
API_URL=http://localhost:5000

# ====================================
# CORS CONFIGURATION
# ====================================
# For production: set to your Vercel frontend URL
# Example: https://soar-siem.vercel.app,https://soar-siem-backend.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173